doctype html
html(lang='en')

    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Tell us what kei truck you are looking for and we will help source one from Japan.')
        meta(name='author', content='Kei-Trucks.com')
        title Request a Kei Truck | Kei-Trucks.com
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css?family=Lato:300,400,700,300italic,400italic,700italic', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@500;600;700&display=swap', rel='stylesheet', type='text/css')
        link(href='css/styles.css?v=logo-visible-20261110', rel='stylesheet')
        script(src='https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js' defer)
        script(src='https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js' defer)
        script(src='js/page-transitions.js?v=logo-visible-20261110' defer)
        script(src='js/cinematic-motion.js' defer)

    body.model-b-page
        nav.navbar.navbar-dark.bg-black.py-3
            .container
                a.navbar-brand.d-flex.align-items-center(href='index.html#home')
                    span.brand-wordmark
                        span.k-letter K
                        span.word-text -TRUCK
                        span.dot .
                        span.word-text FUN
                button.navbar-toggler(type='button' aria-controls='mainNavigation' aria-expanded='false' aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                    span.navbar-menu-label MENU
                    span.navbar-menu-plus(aria-hidden='true') +
                #mainNavigation.navbar-collapse
                    .nav-menu-layout
                        img.nav-menu-photo.nav-menu-photo-left(src='assets/img/k-trucks/menu-truck-left.png' alt='Customized Japanese kei truck' loading='lazy')
                        ul.navbar-nav.ms-auto.align-items-center
                            li.nav-item
                                a.nav-link(href='index.html#home') HOME
                            li.nav-item
                                a.nav-link(href='index.html#trucks') TRUCKS
                            li.nav-item
                                a.nav-link(href='how-it-works.html') HOW IT WORKS
                            li.nav-item
                                a.nav-link(href='index.html#contact') CONTACT
                            li.nav-item
                                a.nav-link(href='about.html') ABOUT US
                        img.nav-menu-photo.nav-menu-photo-right(src='assets/img/k-trucks/menu-truck-right.png' alt='Red Japanese kei truck at sunset' loading='lazy')
                        .nav-menu-social(aria-label='Social media')
                            a.nav-social-link(href='https://www.instagram.com/ktruck.fun?stkn=bnZtb2RjN3dlYTl1&utm_source=qr' target='_blank' rel='noopener noreferrer' aria-label='Instagram')
                                i.bi.bi-instagram(aria-hidden='true')
                            a.nav-social-link(href='https://www.facebook.com/' target='_blank' rel='noopener noreferrer' aria-label='Facebook')
                                i.bi.bi-facebook(aria-hidden='true')

        main.about-page
            header.about-hero
                .container
                    span.subheading Model B
                    h1 Request a Kei Truck
                    p.about-lead Tell us the year, make, transmission, and mileage you prefer. We’ll use your requirements to help source a suitable truck in Japan.

            .container.about-content
                section.about-section.kei-truck-catalog#keiTruckCatalog(aria-labelledby='keiTruckCatalogTitle')
                    h2#keiTruckCatalogTitle Choose a Manufacturer and Model
                    .catalog-layout
                        aside.catalog-filters(aria-label='Filter kei truck models')
                            label(for='catalogSearch') Search makes or models
                            input#catalogSearch.form-control(type='search' placeholder='Search...')
                            details.catalog-filter-group(open)
                                summary Make
                                button.catalog-reset(type='button' data-reset-makes) Reset
                                .catalog-make-list
                                    label.catalog-make-option(data-make-option='Kurogane')
                                        input(type='checkbox' value='Kurogane' data-make-filter)
                                        span Kurogane
                                    label.catalog-make-option(data-make-option='Suzuki')
                                        input(type='checkbox' value='Suzuki' data-make-filter)
                                        span Suzuki
                                    label.catalog-make-option(data-make-option='Daihatsu')
                                        input(type='checkbox' value='Daihatsu' data-make-filter)
                                        span Daihatsu
                                    label.catalog-make-option(data-make-option='Honda')
                                        input(type='checkbox' value='Honda' data-make-filter)
                                        span Honda
                                    label.catalog-make-option(data-make-option='Subaru')
                                        input(type='checkbox' value='Subaru' data-make-filter)
                                        span Subaru
                                    label.catalog-make-option(data-make-option='Mitsubishi')
                                        input(type='checkbox' value='Mitsubishi' data-make-filter)
                                        span Mitsubishi
                                    label.catalog-make-option(data-make-option='Mazda')
                                        input(type='checkbox' value='Mazda' data-make-filter)
                                        span Mazda / Autozam
                                    label.catalog-make-option(data-make-option='Nissan')
                                        input(type='checkbox' value='Nissan' data-make-filter)
                                        span Nissan
                                    label.catalog-make-option(data-make-option='Toyota')
                                        input(type='checkbox' value='Toyota' data-make-filter)
                                        span Toyota
                        .catalog-results
                            p#catalogResultCount.catalog-result-count(aria-live='polite')
                            .catalog-model-list#catalogModelList
                            .catalog-photo-viewer#catalogPhotoViewer(aria-live='polite')
                                p.catalog-photo-placeholder Select a model above to view its photo.
                                figure#catalogSelectedFigure(hidden)
                                    img#catalogSelectedImage(alt='')
                                    figcaption
                                        strong#catalogSelectedTitle
                                        span#catalogSelectedNote
                                        span.catalog-image-credit
                                            | Photo by
                                            |&nbsp;
                                            a#catalogImageAuthor(target='_blank' rel='noopener noreferrer')
                                            |&nbsp;—&nbsp;
                                            a#catalogImageLicense(target='_blank' rel='noopener noreferrer')
                                            |&nbsp;(
                                            a#catalogImageSource(target='_blank' rel='noopener noreferrer') Wikimedia Commons source
                                            |)
                                        span#catalogImageError(role='status' hidden)

                section.about-section
                    h2 Your preferred truck
                    p Give us as much detail as you can. If you are flexible on a specification, you can leave it blank or say “no preference.”
                    form.contact-form(action='https://formsubmit.co/keitrucks.fun@gmail.com' method='POST' accept-charset='UTF-8')
                        input(type='hidden' name='_subject' value='Kei truck sourcing request')
                        input(type='hidden' name='_captcha' value='false')
                        input(type='hidden' name='_template' value='table')
                        input(type='hidden' name='_next' value='https://k-truck.fun/model-b.html')
                        .row.g-2
                            .col-12
                                .truck-preference-filters(aria-label='Truck preferences')
                                    details.truck-preference-filter(open)
                                        summary Year
                                        button.truck-filter-reset(type='button' data-reset-year) Reset
                                        .truck-year-range
                                            .truck-year-select
                                                label(for='truckYearMin') Min
                                                select#truckYearMin.form-control(name='Minimum preferred year')
                                            span.truck-year-separator(aria-hidden='true') –
                                            .truck-year-select
                                                label(for='truckYearMax') Max
                                                select#truckYearMax.form-control(name='Maximum preferred year')
                                    details.truck-preference-filter
                                        summary Transmission
                                        button.truck-filter-reset(type='button' data-reset-transmission) Reset
                                        .truck-preference-options
                                            label
                                                input(type='checkbox' name='Preferred transmission' value='Manual')
                                                span Manual
                                            label
                                                input(type='checkbox' name='Preferred transmission' value='Automatic')
                                                span Automatic
                                    details.truck-preference-filter
                                        summary Fuel type
                                        button.truck-filter-reset(type='button' data-reset-fuel) Reset
                                        .truck-preference-options
                                            label
                                                input(type='checkbox' name='Preferred fuel type' value='Gasoline')
                                                span Gasoline
                                            label
                                                input(type='checkbox' name='Preferred fuel type' value='Diesel')
                                                span Diesel
                                            label
                                                input(type='checkbox' name='Preferred fuel type' value='Electric')
                                                span Electric
                            .col-md-6
                                label(for='truckRequesterName') Name
                                input#truckRequesterName.form-control(type='text' name='Name' placeholder='Your name' required)
                            .col-md-6
                                label(for='truckRequesterEmail') Email
                                input#truckRequesterEmail.form-control(type='email' name='Email' placeholder='you@example.com' required)
                            .col-md-6
                                label(for='truckRequesterCountry') Country
                                input#truckRequesterCountry.form-control(type='text' name='Country' placeholder='Your country')
                            .col-md-6
                                label(for='truckRequesterPhone') Telephone Number
                                input#truckRequesterPhone.form-control(type='tel' name='Telephone Number' placeholder='Optional')
                            .col-md-6
                                label(for='truckModel') Preferred make / model
                                input#truckModel.form-control(type='text' name='Preferred truck make or model' placeholder='e.g. Suzuki Carry')
                            .col-md-6
                                label(for='truckMileage') Preferred mileage
                                input#truckMileage.form-control(type='text' name='Preferred mileage' placeholder='e.g. Under 50,000 km')
                            .col-12
                                label(for='truckExtraDetails') Additional requirements
                                textarea#truckExtraDetails.form-control(name='Additional truck requirements' rows='4' placeholder='Budget, body style, 4WD, intended use, or anything else we should know.')
                            .col-12
                                button.btn.btn-light(type='submit') Send Truck Request
                    a.btn.btn-dark.mt-3(href='index.html#trucks') Back to Trucks

        footer.footer
            .container.d-flex.flex-column.flex-md-row.align-items-center.justify-content-between.gap-3
                p.footer-brand.mb-0 WE <span class='heart'>❤</span> K-Trucks
                a.footer-instagram(href='https://www.instagram.com/ktruck.fun?stkn=bnZtb2RjN3dlYTl1&utm_source=qr' aria-label='Instagram')
                    i.bi.bi-instagram

        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
        script(src='js/nav.js')
        script(src='js/model-b.js')
