doctype html
html(lang='en')

    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Learn how Kei-Trucks.com sources, prepares, and exports kei trucks from Japan through Hakata Port.')
        meta(name='author', content='Kei-Trucks.com')
        title How It Works | Kei-Trucks.com
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css?family=Lato:300,400,700,300italic,400italic,700italic', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@500;600;700&display=swap', rel='stylesheet', type='text/css')
        link(href='css/styles.css?v=black-header-footer-20261127', rel='stylesheet')
        script(src='https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js' defer)
        script(src='https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js' defer)
        script(src='js/page-transitions.js?v=hero-rotation-flow-20261113' defer)
        script(src='js/cinematic-motion.js?v=hero-rotation-flow-20261113' defer)

    body.how-it-works-page
        nav.navbar.navbar-dark.bg-black.py-3
            .container
                a.navbar-brand.d-flex.align-items-center(href='index.html#home')
                    span.brand-wordmark
                        span.k-letter K
                        span.word-text -TRUCK
                        span.dot .
                        span.word-text FUN
                button.navbar-toggler(type='button' aria-controls='mainNavigation' aria-expanded='false' aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                    span.navbar-menu-label MENU
                    span.navbar-menu-plus(aria-hidden='true') +
                #mainNavigation.navbar-collapse
                    .nav-menu-layout
                        img.nav-menu-photo.nav-menu-photo-left(src='assets/img/k-trucks/menu-truck-left.png' alt='Customized Japanese kei truck' loading='lazy')
                        ul.navbar-nav.ms-auto.align-items-center
                            li.nav-item
                                a.nav-link(href='index.html#home') HOME
                            li.nav-item
                                a.nav-link(href='index.html#trucks') TRUCKS
                            li.nav-item
                                a.nav-link(href='how-it-works.html' aria-current='page') HOW IT WORKS
                            li.nav-item
                                a.nav-link(href='index.html#contact') CONTACT
                            li.nav-item
                                a.nav-link(href='about.html') ABOUT US
                        img.nav-menu-photo.nav-menu-photo-right(src='assets/img/k-trucks/menu-truck-right.png' alt='Red Japanese kei truck at sunset' loading='lazy')
                        .nav-menu-social(aria-label='Social media')
                            a.nav-social-link(href='https://www.instagram.com/ktruck.fun?stkn=bnZtb2RjN3dlYTl1&utm_source=qr' target='_blank' rel='noopener noreferrer' aria-label='Instagram')
                                i.bi.bi-instagram(aria-hidden='true')
                            a.nav-social-link(href='https://www.facebook.com/' target='_blank' rel='noopener noreferrer' aria-label='Facebook')
                                i.bi.bi-facebook(aria-hidden='true')

        main
            header.how-hero
                .container
                    a.how-back-link(href='index.html#home')
                        i.bi.bi-arrow-left(aria-hidden='true')
                        | Back to Home
                    p.eyebrow Japan to the world
                    h1 HOW IT WORKS
                    p.how-hero-lead From sourcing in Japan to export arrangements through Hakata Port, here are the key steps for your kei truck.

            section.how-process(aria-label='Export process')
                .container
                    ol.how-timeline
                        li.how-step.how-step--left
                            span.how-step-marker(aria-hidden='true')
                                i.bi.bi-chat-square-text
                            .how-step-copy
                                span.how-step-tag(data-scroll-reveal) STEP 01
                                h2(data-scroll-reveal) Tell us what you need
                                p(data-scroll-reveal) Share your destination, preferred truck, budget, and intended use. We’ll confirm availability, import considerations to check, and a vehicle-specific quote.
                                ul(data-scroll-reveal)
                                    li Destination and delivery preference
                                    li Vehicle requirements and budget
                                    li Written quote before purchase

                        li.how-step.how-step--right
                            span.how-step-marker(aria-hidden='true')
                                i.bi.bi-search
                            .how-step-copy
                                span.how-step-tag(data-scroll-reveal) STEP 02
                                h2(data-scroll-reveal) Source and inspect
                                p(data-scroll-reveal) We look for a suitable used kei truck in Japan and share available vehicle details so you can review its condition and history.
                                ul(data-scroll-reveal)
                                    li Confirm vehicle details and condition
                                    li Review photos and purchase terms
                                    li Proceed only after quote approval

                        li.how-step.how-step--left
                            span.how-step-marker(aria-hidden='true')
                                i.bi.bi-tools
                            .how-step-copy
                                span.how-step-tag(data-scroll-reveal) STEP 03
                                h2(data-scroll-reveal) Prepare for export
                                p(data-scroll-reveal) Selected vehicles can be inspected and professionally repainted through our preparation partner. We confirm the agreed work before shipping.
                                ul(data-scroll-reveal)
                                    li Inspection and agreed preparation
                                    li Vehicle documents checked
                                    li Export plan confirmed

                        li.how-step.how-step--right
                            span.how-step-marker(aria-hidden='true')
                                i.bi.bi-file-earmark-text
                            .how-step-copy
                                span.how-step-tag(data-scroll-reveal) STEP 04
                                h2(data-scroll-reveal) Arrange Hakata shipment
                                p(data-scroll-reveal) For routes through Hakata Port, we coordinate transport to port, Japanese export customs clearance, vehicle documents, and vessel booking.
                                ul(data-scroll-reveal)
                                    li Japan-side transport and port handling
                                    li Export certificate and shipping documents
                                    li Shipping details shared after booking

                        li.how-step.how-step--left
                            span.how-step-marker(aria-hidden='true')
                                i.bi.bi-globe-americas
                            .how-step-copy
                                span.how-step-tag(data-scroll-reveal) STEP 05
                                h2(data-scroll-reveal) Complete destination import
                                p(data-scroll-reveal) Import rules vary by country. The buyer arranges destination customs clearance, duties and taxes, and confirms eligibility and local compliance unless agreed otherwise in writing.
                                ul(data-scroll-reveal)
                                    li Check local import and road-use rules
                                    li Complete customs and payment requirements
                                    li Arrange collection or local delivery

            section.how-costs(aria-labelledby='howCostsTitle')
                .container.how-narrow
                    p.eyebrow(data-scroll-reveal) Cost clarity
                    h2#howCostsTitle(data-scroll-reveal) COST BREAKDOWN
                    p.how-section-lead(data-scroll-reveal) We confirm applicable costs for the selected vehicle and destination before purchase.
                    dl.how-cost-list
                        div(data-scroll-reveal)
                            dt Vehicle and Agreed Preparation
                            dd
                                | $1,000–$8,000
                                br
                                em The price depends on the vehicle model, specifications, and condition.
                        div(data-scroll-reveal)
                            dt Japan-Side Transport and Port Handling
                            dd Approx. $200–$700 USD.
                        div(data-scroll-reveal)
                            dt Export Documentation and Ocean Freight
                            dd
                                ul.how-cost-destinations
                                    li Canada: $1,500–$2,000 USD
                                    li Australia: $1,000–$1,500 USD
                                    li United States: $1,350–$2,400 USD
                        div(data-scroll-reveal)
                            dt Import Duties, Taxes, Customs Clearance and Local Delivery
                            dd Not included. All costs and procedures after arrival in the destination country are the buyer's responsibility.

            section.how-faq(aria-labelledby='howFaqTitle')
                .container.how-narrow
                    p.eyebrow(data-scroll-reveal) Good to know
                    h2#howFaqTitle(data-scroll-reveal) FREQUENTLY ASKED QUESTIONS
                    details.how-faq-item(data-scroll-reveal)
                        summary Can every kei truck be imported?
                        p Some kei trucks can be imported, but not every truck qualifies. Before making a purchase, eligibility depends on the destination’s age, safety, emissions, and registration rules. Please confirm local requirements before purchase.
                        a.how-faq-link(href='eligibility.html') Check Your Kei Truck Eligibility
                    details.how-faq-item(data-scroll-reveal)
                        summary Are import taxes and delivery included?
                        p The quoted price includes all costs up to export from Japan. However, any import procedures, customs clearance, duties, taxes, shipping-related charges, and other expenses incurred after export are the buyer’s responsibility and are not included in our price.
                    details.how-faq-item(data-scroll-reveal)
                        summary Does every shipment leave from Hakata?
                        p Port and vessel options depend on the vehicle, destination, and schedule. We’ll confirm the available route and charges in your quote.
                    details.how-faq-item(data-scroll-reveal)
                        summary What information do you need to start?
                        p Tell us your country, preferred truck or requirements, budget, and intended use. We’ll help clarify the next steps.

            section.how-shipping(aria-labelledby='howShippingTitle')
                .container
                    .how-shipping-heading(data-scroll-reveal)
                        p.eyebrow Shipping from Japan
                        h2#howShippingTitle SHIPPING OPTIONS
                        p.how-section-lead Two common options are roll-on/roll-off (RoRo) and container shipping. Availability and costs depend on the vehicle, route, and destination.
                    .how-shipping-options
                        article.how-shipping-card(data-scroll-reveal)
                            span.how-shipping-icon(aria-hidden='true')
                                i.bi.bi-truck
                            h3 RoRo Shipping
                            p RoRo (roll-on, roll-off) is a practical option for individual trucks and smaller orders. Vehicles are driven onto the vessel and secured for the voyage. At the destination port, you arrange collection or onward transport.
                            p RoRo rates vary by route and season. Contact us for a quote based on your destination.
                            a.how-shipping-link(href='index.html#contact')
                                | GET A SHIPPING QUOTE
                                i.bi.bi-arrow-right(aria-hidden='true')

                        article.how-shipping-card(data-scroll-reveal)
                            span.how-shipping-icon(aria-hidden='true')
                                i.bi.bi-box-seam
                            h3 Container Shipping
                            p A container can carry multiple trucks, making this option worth considering for larger orders or destinations without a suitable RoRo route. The number of vehicles depends on truck and container dimensions.
                            p Ask us about route availability, container rates, and the next steps for your order.
                            a.how-shipping-link(href='index.html#contact')
                                | ASK ABOUT CONTAINER SHIPPING
                                i.bi.bi-arrow-right(aria-hidden='true')

            section.how-cta
                .container
                    h2(data-scroll-reveal) Ready to get started?
                    p(data-scroll-reveal) Tell us what you’re looking for and where you’d like it shipped.
                    a.btn.how-cta-button(data-scroll-reveal href='index.html#contact') CONTACT OUR TEAM

        footer.footer
            .container.d-flex.flex-column.flex-md-row.align-items-center.justify-content-between.gap-3
                p.footer-brand.mb-0 WE <span class='heart'>❤</span> K-Trucks
                a.footer-instagram(href='https://www.instagram.com/ktruck.fun?stkn=bnZtb2RjN3dlYTl1&utm_source=qr' aria-label='Instagram')
                    i.bi.bi-instagram

        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
        script(src='js/nav.js')
        script(src='js/about-reveal.js')
