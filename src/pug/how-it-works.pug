doctype html
html(lang='en')

    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Learn how Kei-Trucks.com sources, prepares, and exports kei trucks from Japan through Hakata Port.')
        meta(name='author', content='Kei-Trucks.com')
        title How It Works | Kei-Trucks.com
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css?family=Lato:300,400,700,300italic,400italic,700italic', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@500;600;700&display=swap', rel='stylesheet', type='text/css')
        link(href='css/styles.css?v=how-it-works-20261102', rel='stylesheet')
        script(src='js/page-transitions.js' defer)

    body.how-it-works-page
        nav.navbar.navbar-dark.bg-black.py-3
            .container
                a.navbar-brand.d-flex.align-items-center(href='index.html#home')
                    span.brand-wordmark
                        span.k-letter K
                        span.word-text -TRUCK
                        span.dot .
                        span.word-text FUN
                button.navbar-toggler(type='button' aria-controls='mainNavigation' aria-expanded='false' aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                    span.navbar-menu-label MENU
                    span.navbar-menu-plus(aria-hidden='true') +
                #mainNavigation.navbar-collapse
                    .nav-menu-layout
                        img.nav-menu-photo.nav-menu-photo-left(src='assets/img/k-trucks/menu-truck-left.png' alt='Customized Japanese kei truck' loading='lazy')
                        ul.navbar-nav.ms-auto.align-items-center
                            li.nav-item
                                a.nav-link(href='index.html#home') HOME
                            li.nav-item
                                a.nav-link(href='index.html#trucks') TRUCKS
                            li.nav-item
                                a.nav-link(href='how-it-works.html' aria-current='page') HOW IT WORKS
                            li.nav-item
                                a.nav-link(href='index.html#contact') CONTACT
                            li.nav-item
                                a.nav-link(href='about.html') ABOUT US
                        img.nav-menu-photo.nav-menu-photo-right(src='assets/img/k-trucks/menu-truck-right.png' alt='Red Japanese kei truck at sunset' loading='lazy')
                        .nav-menu-social(aria-label='Social media')
                            a.nav-social-link(href='https://www.instagram.com/ktruck.fun?stkn=bnZtb2RjN3dlYTl1&utm_source=qr' target='_blank' rel='noopener noreferrer' aria-label='Instagram')
                                i.bi.bi-instagram(aria-hidden='true')
                            a.nav-social-link(href='https://www.facebook.com/' target='_blank' rel='noopener noreferrer' aria-label='Facebook')
                                i.bi.bi-facebook(aria-hidden='true')

        main
            header.how-hero
                .container
                    a.how-back-link(href='index.html#home')
                        i.bi.bi-arrow-left(aria-hidden='true')
                        | Back to Home
                    p.eyebrow Japan to the world
                    h1 HOW IT WORKS
                    p.how-hero-lead From sourcing in Japan to export arrangements through Hakata Port, here are the key steps for your kei truck.

            section.how-process(aria-label='Export process')
                .container
                    ol.how-timeline
                        li.how-step.how-step--left
                            span.how-step-marker(aria-hidden='true')
                                i.bi.bi-chat-square-text
                            .how-step-copy
                                span.how-step-tag STEP 01
                                h2 Tell us what you need
                                p Share your destination, preferred truck, budget, and intended use. We’ll confirm availability, import considerations to check, and a vehicle-specific quote.
                                ul
                                    li Destination and delivery preference
                                    li Vehicle requirements and budget
                                    li Written quote before purchase

                        li.how-step.how-step--right
                            span.how-step-marker(aria-hidden='true')
                                i.bi.bi-search
                            .how-step-copy
                                span.how-step-tag STEP 02
                                h2 Source and inspect
                                p We look for a suitable used kei truck in Japan and share available vehicle details so you can review its condition and history.
                                ul
                                    li Confirm vehicle details and condition
                                    li Review photos and purchase terms
                                    li Proceed only after quote approval

                        li.how-step.how-step--left
                            span.how-step-marker(aria-hidden='true')
                                i.bi.bi-tools
                            .how-step-copy
                                span.how-step-tag STEP 03
                                h2 Prepare for export
                                p Selected vehicles can be inspected and professionally repainted through our preparation partner. We confirm the agreed work before shipping.
                                ul
                                    li Inspection and agreed preparation
                                    li Vehicle documents checked
                                    li Export plan confirmed

                        li.how-step.how-step--right
                            span.how-step-marker(aria-hidden='true')
                                i.bi.bi-file-earmark-text
                            .how-step-copy
                                span.how-step-tag STEP 04
                                h2 Arrange Hakata shipment
                                p For routes through Hakata Port, we coordinate transport to port, Japanese export customs clearance, vehicle documents, and vessel booking.
                                ul
                                    li Japan-side transport and port handling
                                    li Export certificate and shipping documents
                                    li Shipping details shared after booking

                        li.how-step.how-step--left
                            span.how-step-marker(aria-hidden='true')
                                i.bi.bi-globe-americas
                            .how-step-copy
                                span.how-step-tag STEP 05
                                h2 Complete destination import
                                p Import rules vary by country. The buyer arranges destination customs clearance, duties and taxes, and confirms eligibility and local compliance unless agreed otherwise in writing.
                                ul
                                    li Check local import and road-use rules
                                    li Complete customs and payment requirements
                                    li Arrange collection or local delivery

            section.how-costs(aria-labelledby='howCostsTitle')
                .container.how-narrow
                    p.eyebrow Cost clarity
                    h2#howCostsTitle COST BREAKDOWN
                    p.how-section-lead We confirm applicable costs for the selected vehicle and destination before purchase.
                    dl.how-cost-list
                        div
                            dt Vehicle and agreed preparation
                            dd Included as listed in your quote
                        div
                            dt Japan-side transport and port handling
                            dd Depends on vehicle and port arrangements
                        div
                            dt Export documentation and ocean freight
                            dd Confirmed for the destination and route
                        div
                            dt Import duties, taxes, and local delivery
                            dd Buyer responsibility unless agreed otherwise
                    p.how-cost-note Final costs depend on the vehicle, shipping route, and destination-country requirements. Your written quote will specify what is included.

            section.how-faq(aria-labelledby='howFaqTitle')
                .container.how-narrow
                    p.eyebrow Good to know
                    h2#howFaqTitle FREQUENTLY ASKED QUESTIONS
                    details.how-faq-item
                        summary Can every kei truck be imported?
                        p No. Eligibility depends on the destination’s age, safety, emissions, and registration rules. Please confirm local requirements before purchase.
                    details.how-faq-item
                        summary Are import taxes and delivery included?
                        p Only if the written quote says so. Unless agreed otherwise, destination customs clearance, duties, taxes, and local registration are handled by the buyer.
                    details.how-faq-item
                        summary Does every shipment leave from Hakata?
                        p Port and vessel options depend on the vehicle, destination, and schedule. We’ll confirm the available route and charges in your quote.
                    details.how-faq-item
                        summary What information do you need to start?
                        p Tell us your country, preferred truck or requirements, budget, and intended use. We’ll help clarify the next steps.

            section.how-cta
                .container
                    h2 Ready to get started?
                    p Tell us what you’re looking for and where you’d like it shipped.
                    a.btn.how-cta-button(href='index.html#contact') CONTACT OUR TEAM

        footer.footer
            .container.d-flex.flex-column.flex-md-row.align-items-center.justify-content-between.gap-3
                p.footer-brand.mb-0 WE <span class='heart'>❤</span> K-Trucks
                a.footer-instagram(href='https://www.instagram.com/ktruck.fun?stkn=bnZtb2RjN3dlYTl1&utm_source=qr' aria-label='Instagram')
                    i.bi.bi-instagram

        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
        script(src='js/nav.js')
