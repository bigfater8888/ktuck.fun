doctype html
html(lang='en')

    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Review official kei truck import requirements for the United States, Canada, and Australia, and check age-related milestones.')
        meta(name='author', content='Kei-Trucks.com')
        title Kei Truck Import Eligibility | Kei-Trucks.com
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css?family=Lato:300,400,700,300italic,400italic,700italic', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@500;600;700&display=swap', rel='stylesheet', type='text/css')
        link(href='css/styles.css?v=black-header-footer-20261127', rel='stylesheet')
        script(src='https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js' defer)
        script(src='https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js' defer)
        script(src='js/page-transitions.js?v=hero-rotation-flow-20261113' defer)
        script(src='js/cinematic-motion.js?v=hero-rotation-flow-20261113' defer)
        script(src='js/eligibility-check.js?v=eligibility-guide-20261117' defer)

    body.import-guide-page
        nav.navbar.navbar-dark.bg-black.py-3
            .container
                a.navbar-brand.d-flex.align-items-center(href='index.html#home' aria-label='Kei-Trucks.com home')
                    span.brand-wordmark
                        span.k-letter K
                        span.word-text -TRUCK
                        span.dot .
                        span.word-text FUN
                a.import-guide-nav-link(href='how-it-works.html') HOW IT WORKS

        main
            header.import-guide-hero
                .container.import-guide-narrow
                    a.how-back-link(href='how-it-works.html')
                        i.bi.bi-arrow-left(aria-hidden='true')
                        | Back to How It Works
                    p.eyebrow Import guide
                    h1 IMPORTING A KEI TRUCK
                    p.import-guide-lead Review official import information for the United States, Canada, and Australia. Requirements depend on the exact vehicle and your destination.
                    p.import-guide-reviewed Last reviewed: November 17, 2026. Always confirm current rules with the relevant authorities before buying or shipping.

            section.import-guide-country(aria-labelledby='countryGuideTitle')
                .container.import-guide-narrow
                    p.eyebrow Country-by-country
                    h2#countryGuideTitle OFFICIAL REQUIREMENTS
                    .import-guide-tabs(role='tablist' aria-label='Select destination country')
                        button.import-guide-tab(type='button' id='tab-us' role='tab' aria-selected='true' aria-controls='panel-us' tabindex='0' data-country-tab='us') United States
                        button.import-guide-tab(type='button' id='tab-ca' role='tab' aria-selected='false' aria-controls='panel-ca' tabindex='-1' data-country-tab='ca') Canada
                        button.import-guide-tab(type='button' id='tab-au' role='tab' aria-selected='false' aria-controls='panel-au' tabindex='-1' data-country-tab='au') Australia

                    section#importGuidePanels
                        article.import-guide-panel#panel-us(role='tabpanel' aria-labelledby='tab-us' data-country-panel='us')
                            h3 United States
                            p U.S. safety, emissions, customs, and state registration rules are separate checks. NHTSA generally has a 25-year exemption from Federal Motor Vehicle Safety Standards based on the vehicle’s manufacture date; this does not automatically satisfy EPA emissions requirements. EPA has its own age-based provisions and conditions.
                            h4 Start with this document checklist
                            ul.import-guide-checklist
                                li
                                    label
                                        input(type='checkbox')
                                        span Original bill of lading
                                li
                                    label
                                        input(type='checkbox')
                                        span Bill of sale and foreign registration/title
                                li
                                    label
                                        input(type='checkbox')
                                        span DOT Form HS-7 and EPA Form 3520-1, as applicable
                                li
                                    label
                                        input(type='checkbox')
                                        span Evidence supporting the claimed safety and emissions import provision
                            .import-guide-official
                                h4 Official government sources
                                a(href='https://www.nhtsa.gov/importing-vehicle' target='_blank' rel='noopener noreferrer') NHTSA: Importing a Vehicle
                                a(href='https://www.epa.gov/importing-vehicles-and-engines' target='_blank' rel='noopener noreferrer') EPA: Importing Vehicles and Engines
                                a(href='https://www.cbp.gov/trade/basic-import-export/importing-car' target='_blank' rel='noopener noreferrer') U.S. Customs and Border Protection: Importing a Motor Vehicle

                        article.import-guide-panel#panel-ca(role='tabpanel' aria-labelledby='tab-ca' data-country-panel='ca' hidden)
                            h3 Canada
                            p Transport Canada says most vehicles built for foreign markets cannot be imported. One exception is a regulated-class vehicle (not a bus) that is at least 15 years old, calculated from its month and year of manufacture. Other exceptions and requirements may apply; age alone does not guarantee import clearance or provincial registration.
                            h4 Start with this document checklist
                            ul.import-guide-checklist
                                li
                                    label
                                        input(type='checkbox')
                                        span Vehicle documents showing the month and year of manufacture
                                li
                                    label
                                        input(type='checkbox')
                                        span Bill of sale and proof of ownership
                                li
                                    label
                                        input(type='checkbox')
                                        span Shipping document (bill of lading) and export paperwork
                                li
                                    label
                                        input(type='checkbox')
                                        span Customs declaration and supporting documents requested by CBSA
                            .import-guide-official
                                h4 Official government sources
                                a(href='https://tc.canada.ca/en/road-transportation/importing-vehicle/importing-vehicle-countries-other-united-states-mexico' target='_blank' rel='noopener noreferrer') Transport Canada: Vehicles from countries other than the U.S. and Mexico
                                a(href='https://www.cbsa-asfc.gc.ca/publications/dm-md/d19/d19-12-1-eng.html' target='_blank' rel='noopener noreferrer') CBSA: Memorandum D19-12-1

                        article.import-guide-panel#panel-au(role='tabpanel' aria-labelledby='tab-au' data-country-panel='au' hidden)
                            h3 Australia
                            p Australia does not use a single vehicle-age cutoff as a substitute for import approval. Obtain the appropriate Australian vehicle import approval before arranging shipment. Customs clearance, biosecurity cleaning, duties and taxes, and state or territory registration are additional checks.
                            h4 Start with this document checklist
                            ul.import-guide-checklist
                                li
                                    label
                                        input(type='checkbox')
                                        span Vehicle import approval for this specific vehicle
                                li
                                    label
                                        input(type='checkbox')
                                        span Purchase invoice and proof of ownership
                                li
                                    label
                                        input(type='checkbox')
                                        span Bill of lading and import declaration
                                li
                                    label
                                        input(type='checkbox')
                                        span Export, vehicle identity, and biosecurity/cleaning records
                            .import-guide-official
                                h4 Official government sources
                                a(href='https://www.infrastructure.gov.au/infrastructure-transport-vehicles/vehicles/importing-vehicle' target='_blank' rel='noopener noreferrer') Department of Infrastructure: Importing a road vehicle
                                a(href='https://www.abf.gov.au/importing-exporting-and-manufacturing/importing/how-to-import/types-of-imports/importing-a-motor-vehicle' target='_blank' rel='noopener noreferrer') Australian Border Force: Importing a motor vehicle

            section.import-guide-checker(aria-labelledby='importEligibilityCheckerTitle')
                .container.import-guide-narrow
                    p.eyebrow First-step checker
                    h2#importEligibilityCheckerTitle Check Your Kei Truck Eligibility
                    p.import-guide-lead Enter the manufacture month and destination to see an age-related checkpoint and the rules to verify. This is a preliminary guide, not an import approval or legal determination.
                    form#importEligibilityForm
                        .import-guide-form-row
                            div
                                label(for='manufactureMonth') Vehicle manufacture month
                                input#importManufactureMonth(type='month' name='manufactureMonth' required)
                            div
                                label(for='destinationCountry') Import destination
                                select#destinationCountry(name='destinationCountry' required)
                                    option(value='us') United States
                                    option(value='ca') Canada
                                    option(value='au') Australia
                        button.btn.import-guide-submit(type='submit') CHECK REQUIREMENTS
                    .import-guide-result#eligibilityResult(role='status' aria-live='polite' aria-atomic='true' tabindex='-1' hidden)
                    p.import-guide-disclaimer Age calculations use the entered manufacture month and the current month. They do not check vehicle class, safety/emissions compliance, approval pathways, customs charges, or local road registration.

        footer.footer
            .container.d-flex.flex-column.flex-md-row.align-items-center.justify-content-between.gap-3
                p.footer-brand.mb-0 WE <span class='heart'>❤</span> K-Trucks
                a.footer-instagram(href='https://www.instagram.com/ktruck.fun?stkn=bnZtb2RjN3dlYTl1&utm_source=qr' aria-label='Instagram')
                    i.bi.bi-instagram
