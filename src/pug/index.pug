doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title K-Trucks | Heavy Duty Truck Solutions

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        // Bootstrap icons
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css', rel='stylesheet', type='text/css')

        // Google fonts
        link(href='https://fonts.googleapis.com/css?family=Lato:300,400,700,300italic,400italic,700italic', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@500;600;700&display=swap', rel='stylesheet', type='text/css')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body

        // Navigation
        nav.navbar.navbar-dark.bg-black.py-3
            .container
                a.navbar-brand.d-flex.align-items-center(href='#home')
                    span.brand-wordmark
                        span.k-letter K
                        span.word-text -TRUCK
                        span.dot .
                        span.word-text FUN
                button.navbar-toggler(type='button' aria-controls='mainNavigation' aria-expanded='false' aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                    span.navbar-menu-label MENU
                    span.navbar-menu-plus(aria-hidden='true') +
                #mainNavigation.navbar-collapse
                    .nav-menu-layout
                        img.nav-menu-photo.nav-menu-photo-left(src='assets/img/k-trucks/menu-truck-left.png' alt='Customized Japanese kei truck' loading='lazy')
                        ul.navbar-nav.ms-auto.align-items-center
                            li.nav-item
                                a.nav-link(href='#home') HOME
                            li.nav-item
                                a.nav-link(href='#trucks') TRUCKS
                            li.nav-item
                                a.nav-link(href='#contact') CONTACT
                            li.nav-item
                                a.nav-link(href='about.html') ABOUT US
                        img.nav-menu-photo.nav-menu-photo-right(src='assets/img/k-trucks/menu-truck-right.png' alt='Red Japanese kei truck at sunset' loading='lazy')
                        .nav-menu-social(aria-label='Social media')
                            a.nav-social-link(href='https://www.instagram.com/ktruck.fun?stkn=bnZtb2RjN3dlYTl1&utm_source=qr' target='_blank' rel='noopener noreferrer' aria-label='Instagram')
                                i.bi.bi-instagram(aria-hidden='true')
                            a.nav-social-link(href='https://www.facebook.com/' target='_blank' rel='noopener noreferrer' aria-label='Facebook')
                                i.bi.bi-facebook(aria-hidden='true')

        // Hero
        header#home.ktrucks-hero
            .hero-photo
                .hero-orbit(aria-hidden='true')
                    .hero-orbit-item(style='--orbit-angle: 0deg')
                        img(src='assets/img/k-trucks/hero-showcase-01.jpg' alt='' decoding='async')
                    .hero-orbit-item(style='--orbit-angle: 51.43deg')
                        img(src='assets/img/k-trucks/hero-showcase-02.jpg' alt='' decoding='async')
                    .hero-orbit-item(style='--orbit-angle: 102.86deg')
                        img(src='assets/img/k-trucks/hero-showcase-03.jpg' alt='' decoding='async')
                    .hero-orbit-item(style='--orbit-angle: 154.29deg')
                        img(src='assets/img/k-trucks/hero-showcase-04.jpg' alt='' decoding='async')
                    .hero-orbit-item(style='--orbit-angle: 205.71deg')
                        img(src='assets/img/k-trucks/hero-showcase-05.jpg' alt='' decoding='async')
                    .hero-orbit-item(style='--orbit-angle: 257.14deg')
                        img(src='assets/img/k-trucks/hero-showcase-06.jpg' alt='' decoding='async')
                    .hero-orbit-item(style='--orbit-angle: 308.57deg')
                        img(src='assets/img/k-trucks/hero-showcase-07.jpg' alt='' decoding='async')
                .hero-copy-block
                    .hero-copy-inner
                        p.hero-tagline
                            span FUNKY + FUN
                            span.hero-tagline-accent FROM JAPAN
                        a.btn.btn-light.hero-button(href='#trucks') Check Out our Trucks

        main
            // Trucks
            section#trucks.truck-section
                .container
                    .truck-showcase
                        .truck-world-panel(aria-labelledby='truckWorldTitle')
                            include ../assets/img/k-trucks/world-map-dots.svg
                            .truck-world-copy
                                h2#truckWorldTitle OUR TRUCKS
                                p JAPAN TO THE WORLD
                                a.btn.truck-world-button(href='#truckModels') Explore models
                        .truck-model-list#truckModels(aria-label='Truck models')
                            article.truck-card.truck-model-row.model-a-card(data-gallery='model-a' data-title='Truck Model A' data-photo-indicator-count='5' data-photo-path-1='assets/img/k-trucks/model-a-01.jpg' data-photo-path-2='assets/img/k-trucks/model-a-02.jpg' data-photo-path-4='assets/img/k-trucks/model-a-04.jpg' data-photo-path-5='assets/img/k-trucks/model-a-05.jpg' data-photo-path-6='assets/img/k-trucks/model-a-06.jpg' data-photo-path-7='assets/img/k-trucks/model-a-07.jpg' data-photo-path-8='assets/img/k-trucks/model-a-08.jpg' data-photo-path-9='assets/img/k-trucks/model-a-09.jpg')
                                .truck-model-visual
                                    button.truck-card-image-button(type='button' data-gallery-trigger='model-a' aria-label='View Truck Model A photos')
                                        img(src='assets/img/k-trucks/model-a-01.jpg' alt='Truck Model A front view')
                                .truck-model-copy
                                    span.truck-model-index 01 / FOR SALE
                                    h3 Truck Model A
                                    p Clean, prepared kei truck ready for its next journey.
                                .truck-model-action
                                    button.truck-model-link(type='button' data-gallery-trigger='model-a') View photos
                                    a.truck-model-link(href='#contact') Contact us
                            a.truck-card.truck-model-row.model-b-card(href='model-b.html' aria-label='Request a kei truck')
                                .truck-model-visual
                                    img(src='assets/img/k-trucks/hero-showcase-01.jpg' alt='' loading='lazy')
                                .truck-model-copy
                                    span.truck-model-index 02 / SOURCING
                                    h3 Truck Model B
                                    p Tell us what you’re looking for; we’ll find a match in Japan.
                                .truck-model-action
                                    span.truck-model-link Request a truck
                                    span.truck-model-arrow(aria-hidden='true') ↗
                            a.truck-card.truck-model-row.model-c-card(href='model-c.html' aria-label='Request kei truck parts')
                                .truck-model-visual
                                    img(src='assets/img/k-trucks/model-c-parts-transparent.png' alt='Collection of replacement automotive parts' loading='lazy')
                                .truck-model-copy
                                    span.truck-model-index 03 / PARTS
                                    h3 Truck Model C
                                    p Request engine components, replacement parts, or custom parts.
                                .truck-model-action
                                    span.truck-model-link Request parts
                                    span.truck-model-arrow(aria-hidden='true') ↗

            // Contact
            section#contact.contact-section
                .container
                    .row.align-items-center.g-5
                        .col-lg-5
                            .contact-copy
                                span.subheading Contact
                                h2 Contact Us
                                p We're here to assist you with any questions, inquiries, or assistance you may need. Feel free to reach out.
                        .col-lg-7
                            form.contact-form(action='https://formsubmit.co/gen39426@gmail.com' method='POST' accept-charset='UTF-8')
                                input(type='hidden' name='_subject' value='New K-Trucks enquiry')
                                input(type='hidden' name='_captcha' value='false')
                                input(type='hidden' name='_template' value='table')
                                input(type='hidden' name='_next' value='https://k-truck.fun/#contact')
                                .row.g-3
                                    .col-md-6
                                        label(for='name') Name
                                        input#name.form-control(type='text' name='Name' placeholder='Your name' required)
                                    .col-md-6
                                        label(for='company') Company / Organization
                                        input#company.form-control(type='text' name='Company / Organization' placeholder='Company name' required)
                                    .col-md-6
                                        label(for='country') Country
                                        input#country.form-control(type='text' name='Country' placeholder='Country' required)
                                    .col-md-6
                                        label(for='city') City
                                        input#city.form-control(type='text' name='City' placeholder='City' required)
                                    .col-md-6
                                        label(for='telephone') Telephone Number
                                        input#telephone.form-control(type='tel' name='Telephone Number' placeholder='+00 000 000 0000' required)
                                    .col-md-6
                                        label(for='email') Email
                                        input#email.form-control(type='email' name='Email' placeholder='you@example.com' required)
                                    .col-12
                                        button.btn.btn-light(type='submit') Send Enquiry

        // Footer
        footer.footer
            .container.d-flex.flex-column.flex-md-row.align-items-center.justify-content-between.gap-3
                p.footer-brand.mb-0 WE <span class='heart'>❤</span> K-Trucks
                a.footer-instagram(href='https://www.instagram.com/ktruck.fun?stkn=bnZtb2RjN3dlYTl1&utm_source=qr' aria-label='Instagram')
                    i.bi.bi-instagram

        .truck-gallery-modal#truckGalleryModal(aria-hidden='true')
            .truck-gallery-backdrop(data-close-gallery)
            .truck-gallery-panel(role='dialog' aria-modal='true' aria-labelledby='truckGalleryTitle')
                button.truck-gallery-close(type='button' aria-label='Close gallery' data-close-gallery) ×
                .truck-gallery-header
                    h3#truckGalleryTitle Truck Model A
                .truck-gallery-content
                    .truck-gallery-photos
                        .truck-gallery-main
                            img#truckGalleryMainImage(src='assets/img/k-trucks/model-a-01.jpg' alt='Truck Model A photo')
                        .truck-gallery-thumbs#truckGalleryThumbs
                    section.vehicle-details#truckVehicleDetails(hidden aria-labelledby='vehicleDetailsTitle')
                        span.vehicle-details-eyebrow Vehicle details
                        h4#vehicleDetailsTitle 1999 Suzuki Carry
                        dl.vehicle-details-list
                            div
                                dt Year
                                dd 1999
                            div
                                dt Make / model
                                dd Suzuki Carry
                            div
                                dt Mileage
                                dd 47,021 km (29,217 miles)
                            div
                                dt Fuel
                                dd Gasoline
                            div
                                dt Transmission
                                dd Manual
                        p.vehicle-condition Clean interior and exterior; repainted.
                        a.btn.btn-dark.w-100(href='#contact' data-close-gallery) Contact Us

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')

        script(src='js/nav.js')

        // Core theme JS
        script(src='js/scripts.js')