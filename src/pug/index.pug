doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title K-Trucks | Heavy Duty Truck Solutions

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        // Bootstrap icons
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css', rel='stylesheet', type='text/css')

        // Google fonts
        link(href='https://fonts.googleapis.com/css?family=Lato:300,400,700,300italic,400italic,700italic', rel='stylesheet', type='text/css')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body

        // Navigation
        nav.navbar.navbar-expand-lg.navbar-dark.bg-black.py-3
            .container
                a.navbar-brand.d-flex.align-items-center(href='#home')
                    span.brand-wordmark
                        span.k-letter K
                        span.word-text -TRUCK
                        span.dot .
                        span.word-text FUN
                button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#mainNavigation' aria-controls='mainNavigation' aria-expanded='false' aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                #mainNavigation.collapse.navbar-collapse
                    ul.navbar-nav.ms-auto.align-items-center
                        li.nav-item
                            a.nav-link(href='#home') HOME
                        li.nav-item
                            a.nav-link(href='#trucks') TRUCKS
                        li.nav-item
                            a.nav-link(href='#contact') CONTACT

        // Hero
        header#home.ktrucks-hero
            .hero-photo
                .hero-copy-block
                    .hero-copy-inner
                        p
                            | Funky + Fun from Japan
                        a.btn.btn-light.hero-button(href='#trucks') Check Out our Trucks

        main
            // Trucks
            section#trucks.truck-section
                .container
                    h2.section-title Our Trucks
                    .row.g-4.truck-grid
                        .col-lg-4.col-md-6
                            article.truck-card.model-a-card(data-gallery='model-a' data-title='Truck Model A')
                                .truck-card-visual
                                    button.truck-card-image-button(type='button' data-gallery-trigger='model-a' aria-label='View truck photos')
                                        img(src='assets/img/k-trucks/model-a-01.jpg' alt='Truck Model A front view')
                                .truck-card-body
                                    h3 Truck Model A
                                    p.truck-copy
                                        | Engineered for heavy daily use, with dependable power and smart cargo capacity.
                                    a.btn.btn-dark.w-100(href='#contact') Contact Us
                        .col-lg-4.col-md-6
                            .truck-card
                                .truck-card-visual
                                    .truck-card-inset
                                .truck-card-body
                                    h3 Truck Model B
                                    p.truck-copy
                                        | Designed for long-haul efficiency, safer handling, and consistent operation in tough conditions.
                                    a.btn.btn-dark.w-100(href='#contact') Contact Us
                        .col-lg-4.col-md-12
                            .truck-card
                                .truck-card-visual
                                    .truck-card-inset
                                .truck-card-body
                                    h3 Truck Model C
                                    p.truck-copy
                                        | Built for flexibility, comfort, and reliability across demanding transport routes.
                                    a.btn.btn-dark.w-100(href='#contact') Contact Us

            // Contact
            section#contact.contact-section
                .container
                    .row.align-items-center.g-5
                        .col-lg-5
                            .contact-copy
                                span.subheading Contact
                                h2 Let’s talk logistics.
                                p
                                    | Need a dependable truck solution for your fleet or next project?
                                    | Send your details and our team will follow up with the right option for your business.
                        .col-lg-7
                            form.contact-form(action='mailto:gen39426@gmail.com' method='post' enctype='text/plain')
                                .row.g-3
                                    .col-md-6
                                        label(for='name') Name
                                        input#name.form-control(type='text' name='Name' placeholder='Your name' required)
                                    .col-md-6
                                        label(for='company') Company / Organization
                                        input#company.form-control(type='text' name='Company / Organization' placeholder='Company name' required)
                                    .col-md-6
                                        label(for='country') Country
                                        input#country.form-control(type='text' name='Country' placeholder='Country' required)
                                    .col-md-6
                                        label(for='city') City
                                        input#city.form-control(type='text' name='City' placeholder='City' required)
                                    .col-md-6
                                        label(for='telephone') Telephone Number
                                        input#telephone.form-control(type='tel' name='Telephone Number' placeholder='+00 000 000 0000' required)
                                    .col-md-6
                                        label(for='email') Email
                                        input#email.form-control(type='email' name='Email' placeholder='you@example.com' required)
                                    .col-12
                                        button.btn.btn-light(type='submit') Send Enquiry

        // Footer
        footer.footer
            .container.d-flex.flex-column.flex-md-row.align-items-center.justify-content-between.gap-3
                p.footer-brand.mb-0 WE <span class='heart'>❤</span> K-Trucks
                a.footer-instagram(href='https://www.instagram.com/ktruck.fun?stkn=bnZtb2RjN3dlYTl1&utm_source=qr' aria-label='Instagram')
                    i.bi.bi-instagram

        .truck-gallery-modal#truckGalleryModal(aria-hidden='true')
            .truck-gallery-backdrop(data-close-gallery)
            .truck-gallery-panel(role='dialog' aria-modal='true' aria-labelledby='truckGalleryTitle')
                button.truck-gallery-close(type='button' aria-label='Close gallery' data-close-gallery) ×
                .truck-gallery-header
                    h3#truckGalleryTitle Truck Model A
                .truck-gallery-main
                    img#truckGalleryMainImage(src='assets/img/k-trucks/model-a-01.jpg' alt='Truck Model A photo')
                .truck-gallery-thumbs
                    button.truck-gallery-thumb.is-active(type='button' data-index='0')
                        img(src='assets/img/k-trucks/model-a-01.jpg' alt='Truck Model A photo thumb 1')
                    button.truck-gallery-thumb(type='button' data-index='1')
                        img(src='assets/img/k-trucks/model-a-02.jpg' alt='Truck Model A photo thumb 2')
                    button.truck-gallery-thumb(type='button' data-index='2')
                        img(src='assets/img/k-trucks/model-a-03.jpg' alt='Truck Model A photo thumb 3')

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')

        // Core theme JS
        script(src='js/scripts.js')